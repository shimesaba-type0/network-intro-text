{
  "name": "network-intro-text",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ネットワーク基礎再入門（Web/PDF）- Vivliostyle製 Single Source Multi Output",
  "scripts": {
    "build": "npm run build:webpub && npm run build:pdf",
    "build:webpub": "vivliostyle build --output dist/webpub",
    "build:pdf": "vivliostyle build --output dist/book.pdf",
    "preview": "vivliostyle preview",
    "mermaid:build": "node scripts/build-mermaid.mjs"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@vivliostyle/cli": "^11.1.0"
  },
